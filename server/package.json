{
  "name": "duplex-sync-engine-server",
  "version": "2.0.0",
  "description": "Backend for duplex-sync-engine: bi-directional sync between Google Sheets and MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "worker": "node queue/worker.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "loadtest": "node scripts/loadtest.js"
  },
  "keywords": [
    "google-sheets",
    "mysql",
    "sync",
    "bullmq",
    "websocket"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "ioredis": "^5.4.2",
    "mysql2": "^3.17.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}

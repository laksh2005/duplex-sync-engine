# Copy to server/.env and fill in. Never commit the real .env.

# --- HTTP ---
PORT=4000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parity

# --- Google Sheets ---
# Service account with the sheet shared to its client email.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1
GOOGLE_CLIENT_EMAIL=
# Keep the literal \n escapes; the app unescapes them.
GOOGLE_PRIVATE_KEY=

# --- Redis / queue ---
# Unset this to fall back to the in-process runner (no broker needed).
REDIS_URL=redis://localhost:6379
# Collapse a burst of sheet edits into one sync. Lower for a snappier demo,
# raise to do less work under heavy editing.
SYNC_DEBOUNCE_MS=250
SYNC_JOB_ATTEMPTS=5
# Rows per INSERT statement.
SYNC_CHUNK_SIZE=500
# Set to 0 when running a dedicated worker process alongside the API.
RUN_WORKER_INLINE=1

# --- Automatic sync ---
# Shared secret for the Apps Script onEdit webhook. Must match the
# SYNC_WEBHOOK_SECRET script property in Apps Script. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
# How often the DB side is checked for changes. Set to 0 to disable.
# Lower for a snappier demo, at the cost of one more query per tick.
DB_POLL_INTERVAL_MS=2000
